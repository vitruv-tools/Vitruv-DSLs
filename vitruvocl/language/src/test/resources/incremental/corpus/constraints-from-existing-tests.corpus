context spaceMission::Spacecraft inv: self.mass > 0
###
context spaceMission::Spacecraft inv:
  satelliteSystem::Satellite.allInstances().exists(sat | self ~ sat)
###
context spaceMission::Spacecraft inv:
  satelliteSystem::Satellite.allInstances()
    .select(~, Tag = "voyager-match").notEmpty()
###
context spaceMission::Spacecraft inv:
  satelliteSystem::Satellite.allInstances()
    .select(~, Tag = "no-such-tag").isEmpty()
###
context spaceMission::Spacecraft inv:
  satelliteSystem::Satellite.allInstances()
    .reject(~, Tag = "voyager-match").isEmpty()
###
context spaceMission::Spacecraft inv:
  satelliteSystem::Satellite.allInstances()
    .exists(~, Tag = "voyager-match")
###
context spaceMission::Spacecraft inv:
  not satelliteSystem::Satellite.allInstances()
    .exists(~, Tag = "no-such-tag")
###
context satelliteSystem::Satellite inv: true
###
context spaceMission::Spacecraft post: self.mass@pre == 722
###
context spaceMission::Spacecraft post: self.mass == self.mass@pre + 178
###
context spaceMission::Spacecraft post: self.mass@pre == 999
###
context spaceMission::Spacecraft inv massIsPositive:
  self.mass > 0
context spaceMission::Spacecraft post massPreWasWrong:
  self.mass@pre == 999
###
context spaceMission::Spacecraft post: self.OCLisModified
###
context spaceMission::Spacecraft inv: self.mass > 0 post: self.OCLisModified
###
context spaceMission::Spacecraft inv: self.mass < 0 post: self.OCLisModified
###
context spaceMission::Spacecraft post: self.OCLisNew implies self.serialNumber == "SC-002"
###
context spaceMission::Spacecraft post: self.OCLisNew(mass => 500) implies true
###
context spaceMission::Spacecraft post: not self.OCLisNew(mass => 999)
###
context spaceMission::Spacecraft post: not self.OCLisDeleted
